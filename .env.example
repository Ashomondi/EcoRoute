# Copy to backend/.env and adjust. See backend/.env.example for the full list.
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecoroute
DB_PASSWORD=ecoroute
DB_NAME=ecoroute

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h

AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT=2s

CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m

UPLOAD_DIR=./uploads
UPLOAD_URL=/uploads
